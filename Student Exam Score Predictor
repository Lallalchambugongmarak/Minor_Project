import pandas as pd
import numpy as np
from sklearn.model_selection import train_test_split
from sklearn.linear_model import LinearRegression, LogisticRegression
from sklearn.metrics import mean_squared_error, r2_score, accuracy_score, confusion_matrix
import matplotlib.pyplot as plt
import seaborn as sns

# 1. Create Sample Dataset
np.random.seed(42)
n = 500
data = {
    'study_hours': np.random.uniform(1, 10, n),
    'past_score': np.random.uniform(40, 95, n),
    'attendance_%': np.random.uniform(60, 100, n)
}

df = pd.DataFrame(data)

# Formula to generate exam_score for demo
df['exam_score'] = (df['study_hours'] * 5 +
                    df['past_score'] * 0.6 +
                    df['attendance_%'] * 0.2 +
                    np.random.normal(0, 5, n))
df['exam_score'] = df['exam_score'].clip(0, 100)

# Pass/Fail: Pass if score >= 40
df['result'] = df['exam_score'].apply(lambda x: 1 if x >= 40 else 0)

print("Dataset Preview:")
print(df.head())

# 2. FEATURES AND TARGET
X = df[['study_hours', 'past_score', 'attendance_%']]
y_score = df['exam_score'] # for Linear Regression
y_pass = df['result'] # for Logistic Regression

# 3. SPLIT DATA
X_train, X_test, y_score_train, y_score_test, y_pass_train, y_pass_test = train_test_split(
    X, y_score, y_pass, test_size=0.2, random_state=42
)

# 4. MODEL 1: LINEAR REGRESSION - Predict Score
print("\n--- Linear Regression: Predict Exam Score ---")
lin_reg = LinearRegression()
lin_reg.fit(X_train, y_score_train)

y_pred_score = lin_reg.predict(X_test)
print(f"R2 Score: {r2_score(y_score_test, y_pred_score):.2f}")
print(f"RMSE: {np.sqrt(mean_squared_error(y_score_test, y_pred_score)):.2f}")

# 5. MODEL 2: LOGISTIC REGRESSION - Predict Pass/Fail
print("\n--- Logistic Regression: Predict Pass/Fail ---")
log_reg = LogisticRegression()
log_reg.fit(X_train, y_pass_train)

y_pred_pass = log_reg.predict(X_test)
print(f"Accuracy: {accuracy_score(y_pass_test, y_pred_pass):.2f}")
print("Confusion Matrix:")
print(confusion_matrix(y_pass_test, y_pred_pass))

# 6. PREDICT FOR NEW STUDENT
def predict_student(study_hours, past_score, attendance):
    input_data = [[study_hours, past_score, attendance]]
    pred_score = lin_reg.predict(input_data)[0]
    pred_result = "PASS" if log_reg.predict(input_data)[0] == 1 else "FAIL"

    print(f"\n--- Prediction ---")
    print(f"Study Hours: {study_hours}, Past Score: {past_score}, Attendance: {attendance}%")
    print(f"Predicted Exam Score: {pred_score:.2f}")
    print(f"Predicted Result: {pred_result}")

# Example
predict_student(study_hours=7, past_score=75, attendance=85)

# 7. VISUALIZATION
plt.figure(figsize=(8,5))
sns.scatterplot(x=y_score_test, y=y_pred_score)
plt.xlabel("Actual Score")
plt.ylabel("Predicted Score")
plt.title("Actual vs Predicted Exam Scores")
plt.show()
